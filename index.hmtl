<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Profil Pribadi – Nama Lengkap Anda</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#e9eef2; --surface:#ffffff; --ink:#1b2a41; --muted:#56657a;
  --accent:#2f5bea; --accent-soft:#dfe7ff; --sun:#f2b632; --line:#cfd8e2;
  --r:18px;
}
@media (prefers-color-scheme:dark){
  :root{--bg:#121a26; --surface:#1b2636; --ink:#e8eef6; --muted:#9db0c6; --accent:#7fa0ff; --accent-soft:#243456; --sun:#f2b632; --line:#2c3a50;}
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Figtree',system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.65;font-size:1.0625rem}
h1,h2,h3{font-family:'Bricolage Grotesque','Figtree',sans-serif;line-height:1.15}
a{color:var(--accent)}
:focus-visible{outline:3px solid var(--sun);outline-offset:3px}

.wrap{max-width:1120px;margin:0 auto;padding:clamp(16px,4vw,48px);display:grid;grid-template-columns:320px 1fr;gap:clamp(20px,3vw,44px);align-items:start}

/* Kartu profil */
.profile{position:sticky;top:24px;background:var(--ink);color:#f3f6fa;border-radius:var(--r);padding:28px 24px;text-align:center}
@media (prefers-color-scheme:dark){.profile{background:var(--surface);border:1px solid var(--line)}}
.avatar{width:168px;height:168px;border-radius:50%;margin:0 auto 18px;background:var(--accent);border:5px solid var(--sun);overflow:hidden;display:grid;place-items:center;font:800 3.5rem 'Bricolage Grotesque',sans-serif;color:#fff}
.avatar img{width:100%;height:100%;object-fit:cover;display:block}
.profile h1{font-size:1.7rem;font-weight:800}
.profile .tagline{color:#b9c6d8;margin:6px 0 20px;font-size:.98rem}
.profile nav{display:flex;flex-direction:column;gap:8px}
.profile nav a{color:#f3f6fa;text-decoration:none;padding:10px 14px;border-radius:12px;background:rgba(255,255,255,.08);font-weight:500;transition:background .2s}
.profile nav a:hover{background:rgba(255,255,255,.18)}

/* Konten */
main{display:flex;flex-direction:column;gap:clamp(20px,3vw,36px)}
section{background:var(--surface);border-radius:var(--r);padding:clamp(22px,3vw,36px)}
section h2{font-size:clamp(1.5rem,3vw,2rem);font-weight:800;margin-bottom:20px;padding-bottom:12px;border-bottom:3px solid var(--sun);display:inline-block}

.about{margin-bottom:22px;max-width:68ch;color:var(--muted)}
dl.bio{display:grid;grid-template-columns:max-content 1fr;gap:12px 28px}
dl.bio dt{font-weight:600;color:var(--muted)}
dl.bio dd{font-weight:500;overflow-wrap:anywhere}
dl.bio dt,dl.bio dd{padding-bottom:12px;border-bottom:1px solid var(--line)}

.hobbies{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;list-style:none}
.hobbies li{background:var(--accent-soft);border-radius:14px;padding:18px}
.hobbies .ico{font-size:1.8rem;display:block;margin-bottom:6px}
.hobbies h3{font-size:1.15rem;margin-bottom:4px}
.hobbies p{font-size:.95rem;color:var(--muted)}

.sub{font-size:1.2rem;font-weight:700;margin:26px 0 14px}
.sub:first-of-type{margin-top:0}
.photos{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.videos{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px}
figure{border-radius:14px;overflow:hidden;background:var(--accent-soft)}
figure img,figure video{width:100%;display:block;aspect-ratio:4/3;object-fit:cover;background:#000}
figure img{background:var(--accent-soft);color:var(--muted)}
figcaption{padding:10px 14px;font-size:.92rem;color:var(--muted)}

footer{text-align:center;color:var(--muted);font-size:.9rem;padding:8px 0 24px}

@media (max-width:860px){
  .wrap{grid-template-columns:1fr}
  .profile{position:static}
  .profile nav{flex-direction:row;flex-wrap:wrap;justify-content:center}
}
@media (max-width:520px){
  dl.bio{grid-template-columns:1fr;gap:0}
  dl.bio dt{border:0;padding-bottom:0}
  .photos{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>
<div class="wrap">

  <!-- ====== KARTU PROFIL ====== -->
  <aside class="profile">
    <div class="avatar">
      <!-- Ganti dengan foto profil Anda: foto/profil.jpg -->
      <img src="foto/profil.jpg" alt="Foto profil" onerror="this.remove()">
      <span aria-hidden="true">N</span>
    </div>
    <h1>Nama Lengkap Anda</h1>
    <p class="tagline">Pelajar / Mahasiswa / Profesi Anda</p>
    <nav aria-label="Navigasi halaman">
      <a href="#biodata">Biodata</a>
      <a href="#hobi">Hobi</a>
      <a href="#galeri">Galeri</a>
    </nav>
  </aside>

  <main>

    <!-- ====== BIODATA ====== -->
    <section id="biodata">
      <h2>Biodata</h2>
      <p class="about">Halo! Saya [Nama Panggilan]. Tulis perkenalan singkat tentang diri Anda di sini: siapa Anda, apa yang sedang dikerjakan, dan apa yang Anda sukai.</p>
      <dl class="bio">
        <dt>Nama lengkap</dt><dd>Adelia Aisyah Azizah Ahmad</dd>
        <dt>Nama panggilan</dt><dd>Adell</dd>
        <dt>Tempat, tanggal lahir</dt><dd>Kendari, 03 Agustus 2005</dd>
        <dt>Jenis kelamin</dt><dd>Perempuan</dd>
        <dt>Agama</dt><dd>Islam</dd>
        <dt>Alamat</dt><dd>Banjarbaru, Kalimantan Selatan</dd>
        <dt>Pendidikan</dt><dd>Sekolah / Universitas Lambung Mangkurat</dd>
        <dt>Email</dt><dd><a href="mailto:email@contoh.com">yayalyaa2005@Gmail.com</a></dd>
        <dt>Telepon</dt><dd>0895383422228</dd>
      </dl>
    </section>

    <!-- ====== HOBI ====== -->
    <section id="hobi">
      <h2>Hobi</h2>
      <ul class="hobbies">
        <li><span class="ico" aria-hidden="true">📚</span><h3>Memasak</h3><p>membuat hati lebih senang dan membuat kenyang</p></li>
        <li><span class="ico" aria-hidden="true">🎧</span><h3>Mendengarkan Musik</h3><p>membuat hati lebih tenang</p></li>
        <li><span class="ico" aria-hidden="true">⚽</span><h3>Olahraga</h3><p>Olahraga ybasket karna sueru</p></li>
        <li><span class="ico" aria-hidden="true">📷</span><h3>Tidur</h3><p>membuat tubuh lebih rileks</p></li>
      </ul>
    </section>

    <!-- ====== GALERI ====== -->
    <section id="galeri">
      <h2>Galeri</h2>

      <h3 class="sub">Foto</h3>
      <div class="photos">
        <figure><img src="foto/foto1.jpg" alt="Foto 1" loading="lazy"><figcaption>Keterangan foto 1</figcaption></figure>
        <figure><img src="foto/foto2.jpg" alt="Foto 2" loading="lazy"><figcaption>Keterangan foto 2</figcaption></figure>
        <figure><img src="foto/foto3.jpg" alt="Foto 3" loading="lazy"><figcaption>Keterangan foto 3</figcaption></figure>
        <figure><img src="foto/foto4.jpg" alt="Foto 4" loading="lazy"><figcaption>Keterangan foto 4</figcaption></figure>
      </div>

      <h3 class="sub">Video</h3>
      <div class="videos">
        <figure>
          <video controls preload="metadata"><source src="video/video1.mp4" type="video/mp4">Browser Anda tidak mendukung video.</video>
          <figcaption>Keterangan video 1</figcaption>
        </figure>
        <figure>
          <video controls preload="metadata"><source src="video/video2.mp4" type="video/mp4">Browser Anda tidak mendukung video.</video>
          <figcaption>Keterangan video 2</figcaption>
        </figure>
      </div>
    </section>

    <footer>&copy; 2026 Nama Lengkap Anda</footer>
  </main>
</div>
</body>
</html>
